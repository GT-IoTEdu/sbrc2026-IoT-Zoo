# Force LF line endings for code/scripts so shebangs and shell scripts work on
# Linux even when the repo is edited on Windows/WSL. CRLF in a shebang line
# (e.g. "#!/usr/bin/env python3\r") breaks execution of ENTRYPOINT scripts.
* text=auto eol=lf

*.py  text eol=lf
*.sh  text eol=lf
*.c   text eol=lf
*.h   text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf

# Datasets / binaries: leave untouched
*.csv  -text
*.xz   binary
*.png  binary
*.pcap binary
*.mp4  binary
*.log  -text
